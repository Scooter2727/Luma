{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist"
    },
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "backend.app:app",
      "functions": {
        "**/*.py": {
          "includeFiles": "data/{WAYFINDER_ALL_LOCATIONS.csv,ttc_stops.csv,sources/{pedestrian-network.geojson,centreline.geojson,ttc-gtfs.zip,ttc-surface-gtfs.zip}}",
          "excludeFiles": "{node_modules/**,.venv/**,web/**,public/**,dist/**,artifacts/**,data/**,backend/test_*.py,backend/conftest.py,.pytest_cache/**,test-results/**,playwright-report/**}"
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
