# Copy to .env for local development. On Vercel, set these as Environment Variables for the backend service.
# Google Gemini API key, used only by the backend to rephrase route instructions.
GEMINI_API_KEY=
# Gemini model for rephrasing. Defaults to gemini-2.5-flash.
GEMINI_MODEL=
# ElevenLabs API key, used only by the backend to synthesize speech.
ELEVENLABS_API_KEY=
# ElevenLabs voice ID. Defaults to the premade "George" voice.
ELEVENLABS_VOICE_ID=
# ElevenLabs model ID. Defaults to eleven_turbo_v2_5.
ELEVENLABS_MODEL_ID=
